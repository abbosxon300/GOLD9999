{% extends "base.html" %}
{% block content %}


  <!-- === PERIOD TOTAL SUMMARY === -->
  <div style="margin:12px 0; padding:14px 16px; border-radius:16px; background:#fff; border:1px solid rgba(0,0,0,.06);">
    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
      <div style="font-weight:800; font-size:14px;">
        Davr: {{ from_date }} → {{ to_date }}
      </div>
      <div style="opacity:.9; font-size:13px;">
        Sotuvlar soni: <b>{{ sales_count or 0 }}</b>
      </div>
      <div style="font-weight:900; font-size:14px;">
        Umumiy JAMI: <b>{{ "{:,}".format(period_total or 0).replace(",", " ") }}</b> so‘m
      </div>
    </div>
  </div>
<h1 style="font-size:28px; font-weight:800; margin:0 0 14px 0;">Sotilganlar ro‘yxati</h1>

<div style="background:#fff; border-radius:16px; padding:14px; border:1px solid rgba(0,0,0,.06); margin-bottom:12px;">
  <form method="get" action="/sales/history" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
    <span style="opacity:.75; font-size:13px;">Boshlanish:</span>
    <input type="date" name="from" value="{{ from_date }}" style="padding:8px 10px; border:1px solid rgba(0,0,0,.12); border-radius:10px;">
    <span style="opacity:.75; font-size:13px;">Tugash:</span>
    <input type="date" name="to" value="{{ to_date }}" style="padding:8px 10px; border:1px solid rgba(0,0,0,.12); border-radius:10px;">
    <button type="submit" style="padding:9px 14px; border-radius:12px; border:0; font-weight:700;">Ko‘rsat</button>
  </form>
</div>

{% if not sales %}
  <div style="background:#fff; border-radius:16px; padding:18px; border:1px solid rgba(0,0,0,.06);">
    Hozircha sotuv yo‘q.
  </div>
{% else %}
  {% for s in sales %}
    <div style="background:#fff; border-radius:16px; padding:16px; border:1px solid rgba(0,0,0,.06); margin-bottom:12px;">
      <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <div>
          <div style="font-weight:900; font-size:16px;">Sotuv #{{ s.id }}</div>
          <div style="opacity:.75; font-size:13px; margin-top:4px;">
            Sana: {{ s.created_at or "-" }}
            {% if s.agent_name %} · Agent: {{ s.agent_name }}{% endif %}
          </div>
        </div>
        <div style="text-align:right; font-weight:900;">
          Jami: {{ "{:,}".format(s.total_uzs or 0).replace(",", " ") }} so‘m
        </div>
      </div>

      <div style="height:10px;"></div>

      <div style="overflow:auto;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr>
              <th style="text-align:left; padding:8px; border-bottom:1px solid rgba(0,0,0,.08);">Mahsulot</th>
              <th style="text-align:right; padding:8px; border-bottom:1px solid rgba(0,0,0,.08); width:90px;">Qty</th>
              <th style="text-align:right; padding:8px; border-bottom:1px solid rgba(0,0,0,.08); width:130px;">Narx</th>
              <th style="text-align:right; padding:8px; border-bottom:1px solid rgba(0,0,0,.08); width:140px;">Jami</th>
            </tr>
          </thead>
          <tbody>
            {% for it in s["items"] %}
              <tr>
                <td style="padding:8px; border-bottom:1px solid rgba(0,0,0,.06);">{{ it.product_name }}</td>
                <td style="padding:8px; border-bottom:1px solid rgba(0,0,0,.06); text-align:right;">{{ it.qty }}</td>
                <td style="padding:8px; border-bottom:1px solid rgba(0,0,0,.06); text-align:right;">{{ "{:,}".format(it.price_uzs or 0).replace(",", " ") }}</td>
                <td style="padding:8px; border-bottom:1px solid rgba(0,0,0,.06); text-align:right;">{{ "{:,}".format(it.line_total or 0).replace(",", " ") }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    </div>
  {% endfor %}
{% endif %}

{% endblock %}
